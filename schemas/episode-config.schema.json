{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://embodied-trackpad.dev/schemas/episode-config.schema.json",
  "title": "EpisodeConfig",
  "description": "Immutable per-episode configuration and identity (trackpad.v2-draft). episode_id must be a single safe path component. actuator_layout_id is the canonical hash of actuator_order that every ActionChunk must carry.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "episode_id",
    "embodiment_id",
    "actuator_order",
    "joint_order",
    "action_representation",
    "units",
    "calibration_id",
    "bridge_version",
    "cursor_profile",
    "actuator_layout_id"
  ],
  "properties": {
    "schema_version": { "const": "trackpad.v2-draft" },
    "episode_id": { "type": "string", "minLength": 1 },
    "actuator_layout_id": { "type": "string", "minLength": 1 },
    "embodiment_id": { "type": "string", "minLength": 1 },
    "actuator_order": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "joint_order": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "action_representation": {
      "enum": ["normalized_actuator_position_reference"]
    },
    "units": {
      "type": "object",
      "additionalProperties": true,
      "required": ["length", "angle", "time"],
      "properties": {
        "length": { "type": "string", "minLength": 1 },
        "angle": { "type": "string", "minLength": 1 },
        "time": { "type": "string", "minLength": 1 }
      }
    },
    "calibration_id": { "type": "string", "minLength": 1 },
    "bridge_version": { "type": "string", "minLength": 1 },
    "cursor_profile": { "type": "object" }
  }
}
