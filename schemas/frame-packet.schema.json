{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://embodied-trackpad.dev/schemas/frame-packet.schema.json",
  "title": "FramePacket",
  "description": "One captured frame with capture/receive clock identity (trackpad.v2-draft). Cross-domain frame ages are never derived; age_estimate_ms may only come from an explicit synchronization source.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "frame_id",
    "stream_id",
    "capture",
    "receive",
    "image_shape_px",
    "image_ref"
  ],
  "properties": {
    "schema_version": { "const": "trackpad.v2-draft" },
    "frame_id": { "type": "string", "minLength": 1 },
    "stream_id": { "type": "string", "minLength": 1 },
    "capture": { "$ref": "#/$defs/clockStamp" },
    "receive": { "$ref": "#/$defs/clockStamp" },
    "age_estimate_ms": { "type": ["number", "null"], "minimum": 0 },
    "age_uncertainty_ms": { "type": ["number", "null"], "minimum": 0 },
    "image_shape_px": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "integer", "minimum": 1 }
    },
    "image_ref": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "clockStamp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clock_id", "time_ns"],
      "properties": {
        "clock_id": { "type": "string", "minLength": 1 },
        "time_ns": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
